      },
      {
        "family": "Key agreement",
        "profiles": [
          "ECDH",
          "XDH"
        ],
        "operations": [
          "derive shared secret"
        ],
        "required_key": "Keystore private key"
      }
    ],
    "local_examples": [
      "AES-GCM with app-held AES key bytes",
      "RSA encryption or wrapping using an available public key",
      "Signature verification using an available public key",
      "Unkeyed digests, Base64, application envelope serialization, and a KDF over an available shared secret"
    ],
    "mixed_example": "If RSA-OAEP unwrap uses a Keystore private key and returns an application-owned AES content key, only the unwrap requires Keystore. Decrypt the payload locally with the resulting AES key. If the content key instead lives in Keystore, use Keystore for AES-GCM too.",
    "separate_key_management": [
      "Generate a managed key",
      "Import an app-provisioned or securely wrapped key into Keystore",
      "List, inspect, or delete an authorized entry",
      "Read a certificate or public key by alias",
      "Request attestation or manage owner-authorized grants where supported"
    ],
    "capability_rule": "For the selected key, check the operation purpose, parameters, security level, and applicable authentication. Never retry a Keystore request with app-held key material as an implicit fallback.",
    "verification_status": "Design based on the public API. The static firmware inventory does not establish runtime support for these profiles."
  }
