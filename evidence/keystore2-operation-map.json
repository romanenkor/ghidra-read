  "capability_notes": [
    {
      "name": "AES-GCM",
      "operation": "authenticated encryption and decryption",
      "validation": "Test with an app-owned key, provider-generated encryption IV, AAD and tag verification."
    },
    {
      "name": "RSA-OAEP",
      "operation": "encrypt or decrypt small payloads, including app-level key wrapping",
      "validation": "Pin both OAEP digests. Explicit MGF1 digest authorization at key creation is available from API 35."
    },
    {
      "name": "RSA-PSS and RSA PKCS#1 signatures",
      "operation": "sign and verify",
      "validation": "Test key purpose, digest, and signature padding. Keep signing and decryption profiles separate."
    },
    {
      "name": "ECDSA, Ed25519, ECDH, XDH, HMAC",
      "validation": "Test the exact curve or digest, the selected operation, and the requested key security level."
    },
    {
      "name": "ML-DSA-65 and ML-DSA-87",
      "operation": "sign and verify",
      "validation": "API 37 with TEE KeyMint 5 or higher, advertised by FEATURE_HARDWARE_KEYSTORE version 500 or higher."
    },
    {
      "name": "DESede and legacy transformations",
      "validation": "DESede registration is conditional. Treat legacy modes, digests, and padding as explicit compatibility profiles."
    },
    {
      "name": "Key management",
      "operation": "generate, authorized import, secure wrapped import, list and delete app-owned aliases, inspect key authorizations, export public key or certificate chain"
    },
    {
      "name": "Keystore key material",
      "operation": "Use Keystore private and symmetric keys through opaque key references. Public keys and certificate chains are exportable."
    }
  ],
