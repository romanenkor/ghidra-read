  "service_routing": {
    "scope": "Crypto requests for keys the caller is authorized to use. Key provisioning and metadata lookup are separate from the crypto request.",
    "decision": {
      "keystore": "An operand is an opaque AndroidKeyStore private or secret key reference. Use the public AndroidKeyStore API with that key.",
      "local": "All required key material is already available to the app, or the operation requires only public inputs. Leave the request outside the Keystore adapter.",
      "public_material_lookup": "If a public key or certificate is available only by an authorized Keystore alias, resolve it separately. Use the resulting public material for local crypto.",
      "unresolved": "Return a lookup, authorization, or invalid-request error for an unresolved or unusable key reference. A key name alone does not determine key provenance."
    },
    "keystore_crypto_profiles": [
      {
        "family": "AES",
        "profiles": [
          "GCM",
          "explicit legacy CBC or CTR"
        ],
        "operations": [
          "encrypt",
          "decrypt"
        ],
        "required_key": "Keystore secret key"
      },
      {
        "family": "HMAC",
        "profiles": [
          "SHA-256",
          "other supported digest profiles"
        ],
        "operations": [
          "compute MAC",
          "recompute MAC for constant-time comparison"
        ],
        "required_key": "Keystore secret key"
      },
      {
        "family": "RSA encryption",
        "profiles": [
          "OAEP",
          "explicit legacy PKCS#1 v1.5"
        ],
        "operations": [
          "decrypt",
          "unwrap an application-level wrapped payload"
        ],
        "required_key": "Keystore private key"
      },
      {
        "family": "Signatures",
        "profiles": [
          "RSA-PSS",
          "RSA PKCS#1",
          "ECDSA",
          "Ed25519",
          "ML-DSA"
        ],
